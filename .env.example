# Modèle de configuration Vektor — copier en .env et remplir les valeurs.
# Ce fichier ne contient AUCUN secret réel.

APP_ENV=production

# PostgreSQL (conteneur vektor-postgres)
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://vektor:CHANGE_ME@postgres:5432/vektor

# Ollama (via pont socat sur la passerelle Docker, ou IP NetBird depuis l'hôte)
OLLAMA_BASE_URL=http://172.20.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_KEEP_ALIVE=-1

# Telegram (bot dédié, whitelist d'IDs numériques)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# URL interne de la fiche technique pour le bot Telegram (commande /model)
VEKTOR_MODEL_URL=http://vektor-api:8000/api/model

# URL interne du rapport d'exploitation pour le bot Telegram (commande /ops)
VEKTOR_OPS_URL=http://vektor-api:8000/api/ops

# Token interne exigé par X-Vektor-Token sur /api/chat et /api/status
VEKTOR_API_TOKEN=CHANGE_ME

# URL publique (Caddy) — utilisée pour les URLs vocales éventuelles
PUBLIC_BASE_URL=https://vektor.example.ch

# Alexa : Skill ID autorisé (plusieurs IDs séparés par des virgules possibles).
# Vide = TOUTES les requêtes Alexa sont rejetées.
ALEXA_SKILL_ID=

# Proxmox : API en lecture seule (token PVEAuditor) + SSH à commande forcée
PVE_API_URL=https://CHANGE_ME:8006
PVE_API_TOKEN=USER@pve!TOKENID=SECRET
PVE_VERIFY_SSL=0
PVE_SSH_HOST=CHANGE_ME
PVE_SSH_USER=root
PVE_SSH_KEY=/app/secrets/vektor_pve_ed25519

# SSH à commande forcée pour les ACTIONS (deuxième clé dédiée)
VEKTOR_ACTIONS_SSH_KEY=/app/secrets/vektor_actions_ed25519

# Services surveillés (format `nom=url` séparé par des virgules)
VEKTOR_SERVICES=jellyfin=http://JELLYFIN_HOST:8096,sonarr=http://ARR_HOST:8989

# Résolveurs DNS sondés (format `nom=url`, séparés par des virgules).
# Clé API Jellyfin (recherche de la bibliothèque par le LLM, lecture seule).
# Jellyfin 12+ exige la forme Authorization MediaBrowser (gérée par le code).
VEKTOR_JELLYFIN_TOKEN=

# 2e endpoint d'inférence (optionnel) : ex. une machine locale puissante
# jointe au VPN. Si défini ET joignable, il sert les inférences ; sinon le
# primaire prend le relais sans erreur visible. Vide = désactivé.
OLLAMA_FALLBACK_URL=

# Heartbeat du bot (auto-supervision) : URL de ping Healthchecks dédiée au
# bot Telegram. Si le bot crash, le check passe down et alerte. Vide = off.
VEKTOR_HC_PING_URL=

# Heartbeat de l'API (auto-supervision symétrique) : ping 5 min depuis
# app.main (lifespan). Si l'API meurt, le check passe down en ~5-10 min.
# Vide = désactivé.
VEKTOR_HC_API_PING_URL=

# Sonde des noms internes du /dns (optionnel) : un nom que seuls vos
# résolveurs LAN peuvent résoudre (hôte du VPN, service local). Vide = section
# désactivée. La valeur réelle vit dans le .env de production.
VEKTOR_DNS_INTERNAL_PROBE=

# Transports : udp://IP:PORT (LAN), https://.../dns-query?{dns} (DoH wire),
# https://.../dns-query (DoH JSON)
VEKTOR_DNS_RESOLVERS=local=udp://DNS_IP:53

# Monitoring Healthchecks.io (token LECTURE SEULE, obtenu via API read-only)
VEKTOR_HC_API_URL=
VEKTOR_HC_READ_TOKEN=

# Pont Ollama : IP NetBird / LAN du serveur Ollama (utilisé par le conteneur socat)
OLLAMA_NETBIRD_HOST=CHANGE_ME
